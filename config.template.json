{
  "$schema": "https://www.getbifrost.ai/schema",
  ${BIFROST_STORE_BLOCK}
  "client": {
    "drop_excess_requests": false
  },
  "providers": {
    "aquadoor-llm": {
      "keys": [
        { "name": "aquadoor-llm-key", "value": "env.AQUADOOR_LLM_API_KEY", "models": ["*"], "weight": 1.0 }
      ],
      "network_config": { "base_url": "${AQUADOOR_LLM_BASE_URL}" },
      "custom_provider_config": {
        "base_provider_type": "openai",
        "allowed_requests": {
          "chat_completion": true,
          "chat_completion_stream": true,
          "embedding": true,
          "image_generation": true
        }
      }
    }
  },
  "mcp": {
    "client_configs": ${AQUADOOR_RUNNER_MCP_CLIENTS}
  },
  "governance": {
    "auth_config": {
      "admin_username": "env.BIFROST_ADMIN_USERNAME",
      "admin_password": "env.BIFROST_ADMIN_PASSWORD",
      "is_enabled": true
    },
    "virtual_keys": []
  },
  "plugins": [
    { "name": "governance", "enabled": true, "config": { "is_vk_mandatory": true } },
    {
      "name": "aquadoor-pii",
      "enabled": true,
      "config": {
        "Language": "ru",
        "DefaultAction": "redact",
        "Actions": {
          "RU_INN_LEGAL": "allow",
          "RU_OGRN": "allow",
          "RU_INN": "redact",
          "RU_OGRNIP": "redact",
          "RU_PHONE": "redact",
          "RU_PASSPORT": "redact"
        }
      }
    },
    {
      "name": "aquadoor-obo",
      "enabled": true,
      "config": {
        "Issuer": "${AQUADOOR_OBO_ISSUER}",
        "BackendProjectID": "${AQUADOOR_OBO_BACKEND_PROJECT_ID}",
        "UpstreamClientID": "${AQUADOOR_OBO_UPSTREAM_CLIENT_ID}",
        "RunnerToolPrefixes": ["aquadoor_runner_"],
        "RunnerClients": ${AQUADOOR_OBO_RUNNER_CLIENTS},
        "RunnerAudience": "${AQUADOOR_OBO_RUNNER_AUDIENCE}",
        "Strategy": "impersonation"
      }
    }
  ]
}
